digraph{rankdir=LR;bgcolor=transparent;node[shape=box style="rounded,filled" fillcolor="#E6F1FB" color="#1E3A5F" fontname=Helvetica fontsize=11 penwidth=1.5 width=1.5];edge[color="#00A6A6" penwidth=2];
S1[label="1. Server sends\nglobal model"];S2[label="2. Each client\ntrains locally"];S3[label="3. Clients send\nweights back"];S4[label="4. Server averages\ninto new model"];S5[label="5. Repeat\n(model improves)" fillcolor="#D9E2F3"];
S1->S2->S3->S4->S5; S5->S1[label="next round" constraint=false color="#9AA7B4" style=dashed fontsize=9];}
