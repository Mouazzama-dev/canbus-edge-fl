digraph { rankdir=TB; bgcolor="transparent";
  node[shape=box style="rounded,filled" fillcolor="#E6F1FB" color="#1f77b4" fontname="Helvetica" fontsize=11 penwidth=1.5];
  edge[fontname="Helvetica" fontsize=10 color="#555555"];
  S[label="SuperLink server\nholds global model\naggregate + evaluate" fillcolor="#D9E2F3" penwidth=2];
  subgraph cluster_c { style=invis;
    C0[label="SuperNode 0\nNormal + DoS\ncore 0"]; C1[label="SuperNode 1\nNormal + Fuzzy\ncore 1"];
    C2[label="SuperNode 2\nNormal + Gear\ncore 2"]; C3[label="SuperNode 3\nNormal + RPM\ncore 3"]; }
  S -> C0 [label="1. send model + config"]; S -> C1; S -> C2; S -> C3;
  C0 -> S [label="2. return trained weights" constraint=false]; C1 -> S [constraint=false]; C2 -> S [constraint=false]; C3 -> S [constraint=false];
}
